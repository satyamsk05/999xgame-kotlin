# Server Configuration
APP_ENV=development
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ingames_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_POOL_SIZE=10

# Redis Cache & Session Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Configuration
JWT_SECRET=999xgame_super_secret_jwt_signing_key_32bytes
ADMIN_JWT_SECRET=999xgame_admin_jwt_secret_signing_key_32bytes
JWT_ISSUER=ingames-backend
JWT_AUDIENCE=ingames-client
JWT_EXPIRATION_SECONDS=2592000
ADMIN_JWT_EXPIRATION_SECONDS=86400

# Loggin.dev OTP-less WhatsApp Integration
LOGGIN_APP_KEY=
LOGGIN_API_URL=https://api.loggin.dev/v1
